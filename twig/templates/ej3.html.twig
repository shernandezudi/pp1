<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Países</title>
</head>
<body>

{% for indice, pais in paises %}
    Índice: {{ indice }} <br>
    País: {{ pais.nombre }} <br>
    Lengua: {{ pais.lengua }} <br>
    Moneda: {{ pais.moneda }} <br>
    <hr>
{% else %}
    No existen países.
{% endfor %}

</body>
</html>